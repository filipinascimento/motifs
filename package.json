{
  "name": "hierarchical-device-motif-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "data:check": "node scripts/public_data.mjs check public/data/hierarchical_motifs.json && node scripts/public_engineering_data.mjs check public/data/engineering/manifest.json",
    "data:parity": "node scripts/check_bundle_parity.mjs public/data/hierarchical_motifs.json public/data/engineering/manifest.json",
    "test": "node --test tests/*.test.js",
    "test:search": "node scripts/test_search.mjs",
    "build": "npm run data:check && npm test && npm run test:search && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "helios-network": "^0.10.4",
    "helios-web": "^0.10.9"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "overrides": {
    "helios-web": {
      "d3-force-3d": "3.0.2"
    }
  }
}
